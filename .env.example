# Single shared login for the whole app — it fronts your paid API keys, so
# make this LONG and random (e.g. `openssl rand -base64 24`), not a word.
ACCESS_CODE=

# Content generation — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# TEACHME_MODEL=google/gemini-2.5-flash

# Audio — an Azure Speech resource (free F0 tier covers ~20 series/month):
# https://portal.azure.com → Create resource → Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# TEACHME_VOICE=en-US-AndrewMultilingualNeural

# Optional: your deployment's public URL, sent to OpenRouter as app attribution
# TEACHME_APP_URL=https://teachme.example.com
